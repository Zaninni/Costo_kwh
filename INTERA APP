import React, { useState, useEffect } from 'react';

const App = () => {
  // --- CARD 1: IMPOSTAZIONI (Parametri Fissi) ---
  const [costoEnergia, setCostoEnergia] = useState(0.22); 
  const [perditeRete, setPerditeRete] = useState(5); 
  const [ammortamento, setAmmortamento] = useState(0.04);
  const [quotaGestione, setQuotaGestione] = useState(0);
  const [percentualeJCP, setPercentualeJCP] = useState(6);
  const [stripePerc, setStripePerc] = useState(3);
  const [stripeFisso, setStripeFisso] = useState(0.30);

  // --- CARD 2: SIMULAZIONE (Input Variabili) ---
  const [kwh, setKwh] = useState(30);
  const [targetLordo, setTargetLordo] = useState(0.35); // Per il calcolo inverso
  const [calcMode, setCalcMode] = useState('forward'); // 'forward' = da costi a prezzo, 'reverse' = da prezzo a ripartizione

  // --- RISULTATI ---
  const [results, setResults] = useState({
    lordoCliente: 0,
    incassoCPONetto: 0, // Imponibile totale
    nettoINFN: 0,       // Quota 94%
    lordoJCP: 0,        // Quota 6% (pre-Stripe)
    stripeCost: 0,
    nettoJCP: 0,
    prezzoUnitario: 0
  });

  useEffect(() => {
    // 1. Costo unitario industriale INFN
    const unitarioINFN = (costoEnergia * (1 + perditeRete / 100)) + ammortamento + quotaGestione;
    
    let imponibileTotale = 0;

    if (calcMode === 'forward') {
      // CALCOLO DIRETTO: Vogliamo coprire il costo INFN
      // Se INFN = 94% dell'imponibile -> Imponibile = INFN / 0.94
      const totaleNecessarioINFN = unitarioINFN * kwh;
      imponibileTotale = totaleNecessarioINFN / (1 - (percentualeJCP / 100));
    } else {
      // CALCOLO INVERSO: Partiamo da un prezzo lordo (es. 0.35 €/kWh)
      const lordoTotale = targetLordo * kwh;
      imponibileTotale = lordoTotale / 1.22;
    }

    const lordoCliente = imponibileTotale * 1.22;
    const nettoINFN = imponibileTotale * (1 - (percentualeJCP / 100));
    const lordoJCP = imponibileTotale * (percentualeJCP / 100);
    const stripeCost = (imponibileTotale * (stripePerc / 100)) + stripeFisso;
    const nettoJCP = lordoJCP - stripeCost;

    setResults({
      lordoCliente,
      incassoCPONetto: imponibileTotale,
      nettoINFN,
      lordoJCP,
      stripeCost,
      nettoJCP,
      prezzoUnitario: lordoCliente / kwh
    });
  }, [costoEnergia, perditeRete, ammortamento, quotaGestione, percentualeJCP, stripePerc, stripeFisso, kwh, targetLordo, calcMode]);

  return (
    <div className="min-h-screen bg-slate-100 p-4 md:p-8 font-sans text-slate-900">
      <div className="max-w-6xl mx-auto space-y-6">
        
        {/* TITOLO PRINCIPALE */}
        <div className="bg-white p-6 rounded-xl shadow-sm border-b-4 border-blue-600">
          <h1 className="text-2xl font-black uppercase italic tracking-tight">Strumento di Rendicontazione LNF</h1>
          <p className="text-slate-500 text-sm font-bold uppercase">Recupero Costi Energia & Infrastruttura</p>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          
          {/* CARD 1: IMPOSTAZIONE */}
          <div className="bg-white p-6 rounded-2xl shadow-md space-y-4">
            <h2 className="text-xs font-black text-blue-600 uppercase tracking-widest border-b pb-2">Card Impostazione</h2>
            
            <div className="space-y-3">
              <div>
                <label className="block text-[10px] font-bold text-slate-400 uppercase">Costo Energia (€/kWh)</label>
                <input type="number" value={costoEnergia} onChange={e => setCostoEnergia(Number(e.target.value))} step="0.001" className="w-full p-2 bg-slate-50 border rounded-lg font-mono" />
              </div>
              <div className="grid grid-cols-2 gap-2">
                <div>
                  <label className="block text-[10px] font-bold text-slate-400 uppercase">Perdite Rete (%)</label>
                  <input type="number" value={perditeRete} onChange={e => setPerditeRete(Number(e.target.value))} className="w-full p-2 bg-slate-50 border rounded-lg" />
                </div>
                <div>
                  <label className="block text-[10px] font-bold text-blue-500 uppercase">JCP Fee (%)</label>
                  <input type="number" value={percentualeJCP} onChange={e => setPercentualeJCP(Number(e.target.value))} className="w-full p-2 bg-blue-50 border border-blue-200 text-blue-600 font-bold rounded-lg" />
                </div>
              </div>
              <div>
                <label className="block text-[10px] font-bold text-slate-400 uppercase">Ammortamento (€/kWh)</label>
                <input type="number" value={ammortamento} onChange={e => setAmmortamento(Number(e.target.value))} step="0.001" className="w-full p-2 bg-slate-50 border rounded-lg" />
              </div>
              
              <div className="pt-4 mt-4 border-t border-dashed">
                <p className="text-[10px] font-bold text-red-400 uppercase mb-2">Parametri Stripe (Netto)</p>
                <div className="grid grid-cols-2 gap-2">
                  <input type="number" value={stripePerc} onChange={e => setStripePerc(Number(e.target.value))} placeholder="%" className="w-full p-2 text-xs border rounded" />
                  <input type="number" value={stripeFisso} onChange={e => setStripeFisso(Number(e.target.value))} placeholder="€ Fisso" className="w-full p-2 text-xs border rounded" />
                </div>
              </div>
            </div>
          </div>

          {/* CARD 2: SIMULAZIONE */}
          <div className="bg-white p-6 rounded-2xl shadow-md space-y-6">
            <h2 className="text-xs font-black text-orange-500 uppercase tracking-widest border-b pb-2">Card Simulazione</h2>
            
            <div>
              <label className="block text-xs font-bold text-slate-400 uppercase mb-1">Energia Erogata</label>
              <div className="flex items-baseline gap-2">
                <input type="number" value={kwh} onChange={e => setKwh(Number(e.target.value))} className="w-full text-5xl font-black outline-none border-none bg-transparent" />
                <span className="text-xl font-bold text-slate-300">kWh</span>
              </div>
            </div>

            <div className="space-y-2">
              <button 
                onClick={() => setCalcMode('forward')}
                className={`w-full p-3 rounded-xl text-left text-xs font-bold transition-all ${calcMode === 'forward' ? 'bg-blue-600 text-white shadow-lg' : 'bg-slate-50 text-slate-400 border border-slate-100'}`}
              >
                A) Calcolo PREZZO dal costo ENTE
              </button>
              <button 
                onClick={() => setCalcMode('reverse')}
                className={`w-full p-3 rounded-xl text-left text-xs font-bold transition-all ${calcMode === 'reverse' ? 'bg-orange-500 text-white shadow-lg' : 'bg-slate-50 text-slate-400 border border-slate-100'}`}
              >
                B) Calcolo RIPARTIZIONE dal prezzo lordo
              </button>
              {calcMode === 'reverse' && (
                <div className="mt-2 p-3 bg-orange-50 rounded-lg border border-orange-100">
                  <label className="block text-[10px] font-bold text-orange-600 uppercase mb-1">Imposta Prezzo Lordo (€/kWh)</label>
                  <input type="number" value={targetLordo} onChange={e => setTargetLordo(Number(e.target.value))} step="0.01" className="w-full p-2 border rounded-lg font-bold" />
                </div>
              )}
            </div>
          </div>

          {/* CARD 3: RISULTATI */}
          <div className="bg-white p-6 rounded-2xl shadow-md flex flex-col">
            <h2 className="text-xs font-black text-emerald-600 uppercase tracking-widest border-b pb-2">Card Risultati</h2>
            
            <div className="mt-6 flex-grow space-y-6">
              <div>
                <span className="text-[10px] font-bold text-slate-400 uppercase">Prezzo Finale Cliente (Lordo)</span>
                <p className="text-4xl font-black text-slate-900">{results.lordoCliente.toFixed(2)} €</p>
                <p className="text-xs font-bold text-emerald-600">Unitario: {results.prezzoUnitario.toFixed(3)} €/kWh</p>
              </div>

              <div className="space-y-3">
                <div className="flex justify-between items-center p-3 bg-blue-50 rounded-xl border border-blue-100">
                  <span className="text-[10px] font-bold text-blue-600 uppercase">Netto INFN (SubCPO)</span>
                  <span className="font-black text-blue-700">{results.nettoINFN.toFixed(2)} €</span>
                </div>
                
                <div className="flex justify-between items-center p-3 bg-orange-50 rounded-xl border border-orange-100">
                  <span className="text-[10px] font-bold text-orange-600 uppercase">Lordo JCP (6%)</span>
                  <span className="font-black text-orange-700">{results.lordoJCP.toFixed(2)} €</span>
                </div>
              </div>

              <div className="pt-4 border-t border-slate-100">
                <div className="flex justify-between text-[10px] text-slate-400 mb-1">
                  <span>COSTO STRIPE (Pagato da JCP):</span>
                  <span className="font-bold text-red-500">-{results.stripeCost.toFixed(2)} €</span>
                </div>
                <div className={`flex justify-between p-2 rounded-lg font-bold ${results.nettoJCP > 0 ? 'bg-emerald-50 text-emerald-700' : 'bg-red-50 text-red-700'}`}>
                  <span className="text-[10px] uppercase">Utile Reale JCP:</span>
                  <span className="text-sm">{results.nettoJCP.toFixed(2)} €</span>
                </div>
              </div>
            </div>
          </div>

        </div>

        {/* TABELLA RENDICONTO (Stile originale JPG) */}
        <div className="bg-slate-900 rounded-2xl overflow-hidden shadow-2xl">
          <div className="bg-slate-800 px-6 py-4 flex justify-between items-center border-b border-slate-700">
            <h3 className="text-sm font-black text-slate-300 uppercase tracking-widest">Anteprima Imponibili (Rendiconto Netto)</h3>
          </div>
          <table className="w-full text-center border-collapse">
            <thead>
              <tr className="text-[10px] text-slate-500 uppercase font-bold bg-slate-800/40">
                <th className="py-4 border-r border-slate-800">kWh</th>
                <th className="py-4 border-r border-slate-800">Incasso CPO (Netto)</th>
                <th className="py-4 border-r border-slate-800">Costo SubCPO (INFN)</th>
                <th className="py-4 border-r border-slate-800">Utile CPO (6%)</th>
                <th className="py-4">Ammanco Stripe (a carico JCP)</th>
              </tr>
            </thead>
            <tbody className="text-white font-mono">
              <tr className="border-t border-slate-800">
                <td className="py-6 text-2xl font-black">{kwh}</td>
                <td className="py-6 text-2xl font-black text-slate-400">{results.incassoCPONetto.toFixed(2)} €</td>
                <td className="py-6 text-2xl font-black text-blue-400">{results.nettoINFN.toFixed(2)} €</td>
                <td className="py-6 text-2xl font-black text-orange-500">{results.lordoJCP.toFixed(2)} €</td>
                <td className="py-6 text-xl font-bold text-red-500/60">{results.stripeCost.toFixed(2)} €</td>
              </tr>
            </tbody>
          </table>
        </div>

      </div>
    </div>
  );
};

export default App;
